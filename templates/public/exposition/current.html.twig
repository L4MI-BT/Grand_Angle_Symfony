{% extends 'public/base_public.html.twig' %}

{% block title %}{{ exposition.titre }} - Grand Angle{% endblock %}

{% block main %}
<div class="container py-5">
    
    <div class="row mb-5">
        <div class="col-md-6">
            <h1 class="display-1 text-vert-sapin mb-3">{{ exposition.titre }}</h1>
            
            {% if exposition.theme %}
                <p class="lead text-vert-sapin fw-bold mb-3">{{ exposition.theme }}</p>
            {% endif %}
            
            <p class="text-muted mb-2">
                <i class="bi bi-calendar-event"></i>
                Du {{ exposition.dateDebut|date('d/m/Y') }} 
                au {{ exposition.dateFin|date('d/m/Y') }}
            </p>
            
            <p class="text-muted mb-4">
                <i class="bi bi-clock"></i>
                <strong>Horaires :</strong> {{ horaires }}
            </p>
            
            {% if exposition.description %}
                <p class="mt-3">{{ exposition.description }}</p>
            {% endif %}
        </div>
        
        <div class="col-md-6">
            {% if exposition.image %}
                <img src="{{ asset("styles/#{exposition.image}") }}" class="img-fluid rounded shadow" alt="{{ exposition.titre }}">
            {% else %}
                <div class="bg-secondary rounded" style="height: 300px; display: flex; align-items: center; justify-content: center;">
                    <span class="text-white">Image de l'exposition</span>
                </div>
            {% endif %}
        </div>
    </div>
    
    {# ========== PLAN DE L'EXPOSITION ========== #}
    {% if emplacements is not empty %}
    <div class="card mb-5 shadow-sm border-vert-sapin">
        <div class="card-body">
            <h2 class="mb-4 text-center">Plan de l'exposition</h2>
            
            {# LEGENDE #}
            <div class="row mb-3">
                {% for emplacement in emplacements %}
                    {% if emplacement.oeuvres is not empty %}
                        {% for oeuvre in emplacement.oeuvres %}
                        <div class="col-md-3 mb-2">
                            <span class="badge bg-success me-2">{{ oeuvre.numeroIdentification ?? '?' }}</span>
                            <span>{{ oeuvre.titre }}</span>
                        </div>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>

            {# PLAN SVG #}
            <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" style="width: 100%; border-radius: 8px; background-color: #f8f9fa;">

                {# BATIMENT PRINCIPAL #}
                <rect x="20" y="20" width="860" height="460" fill="none" stroke="#2d6a4f" stroke-width="3"/>

                {# HALL PRINCIPAL #}
                <rect x="620" y="20" width="260" height="460" fill="#e8f5e9" stroke="#2d6a4f" stroke-width="2"/>
                <text x="750" y="260" fill="#2d6a4f" font-size="14" text-anchor="middle">Hall Principal</text>

                {# ESPACE 2 (nord-est) #}
                <rect x="320" y="20" width="300" height="220" fill="#e8f5e9" stroke="#2d6a4f" stroke-width="2"/>
                <text x="470" y="120" fill="#2d6a4f" font-size="14" text-anchor="middle">Espace 2</text>

                {# ESPACE 1 (sud-est) #}
                <rect x="320" y="260" width="300" height="220" fill="#e8f5e9" stroke="#2d6a4f" stroke-width="2"/>
                <text x="470" y="380" fill="#2d6a4f" font-size="14" text-anchor="middle">Espace 1</text>

                {# ESPACE 3 (ouest) #}
                <rect x="20" y="20" width="300" height="460" fill="#e8f5e9" stroke="#2d6a4f" stroke-width="2"/>
                <text x="170" y="260" fill="#2d6a4f" font-size="14" text-anchor="middle">Espace 3</text>

                {# EMPLACEMENTS ET OEUVRES #}
                {% for emplacement in emplacements %}
                    {% if emplacement.oeuvres is not empty %}
                        {% for oeuvre in emplacement.oeuvres %}
                            {% set px = (emplacement.positionX * 100) %}
                            {% set py = (emplacement.positionY * 100) %}
                            <a href="{{ path('oeuvre_show', {'id': oeuvre.id}) }}">
                                <rect x="{{ px - 15 }}" y="{{ py - 15 }}" 
                                    width="30" height="30" 
                                    fill="#2d6a4f" stroke="#fff" stroke-width="1" 
                                    rx="4"/>
                                <text x="{{ px }}" y="{{ py + 5 }}" 
                                    fill="#fff" font-size="12" 
                                    text-anchor="middle" font-weight="bold">
                                    {{ oeuvre.numeroIdentification ?? '?' }}
                                </text>
                            </a>
                        {% endfor %}
                    {% endif %}
                {% endfor %}

            </svg>
        </div>
    </div>
    {% endif %}
    
    {# ========== ARTISTES ========== #}
    <div class="mb-5">
        <h2 class="mb-4">Artistes</h2>
        
        <div class="row g-4">
            {% for artiste in artistes %}
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm text-center">
                        {% if artiste.image %}
                            <img src="{{ asset("styles/#{artiste.image}") }}" class="card-img-top" alt="{{ artiste.prenom }} {{ artiste.nom }}" style="height: 200px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-person-circle text-white" style="font-size: 4rem;"></i>
                            </div>
                        {% endif %}
                        
                        <div class="card-body">
                            <h5 class="card-title">{{ artiste.prenom }} {{ artiste.nom }}</h5>
                            <a href="{{ path('app_artiste',{id:artiste.id}) }}" class="btn btn-primary-custom mt-3">
                                <i class="bi bi-eye"></i> Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    
    {# ========== OEUVRES (ALTERNÉES) ========== #}
    <div class="mb-5">
        <h2 class="mb-4">Œuvres</h2>
        
        {% for oeuvre in oeuvres %}
            <div class="card mb-4 shadow-sm">
                <div class="row g-0 {% if loop.index is odd %}flex-row{% else %}flex-row-reverse{% endif %}">
                    {# IMAGE #}
                    <div class="col-md-5">
                        {% if oeuvre.image %}
                            <img src="{{ asset("styles/#{oeuvre.image}") }}" class="img-fluid h-100 w-100" alt="{{ oeuvre.titre }}" style="object-fit: cover; min-height: 300px;">
                        {% else %}
                            <div class="bg-secondary h-100 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                                <i class="bi bi-image text-white" style="font-size: 4rem;"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    {# CONTENU #}
                    <div class="col-md-7">
                        <div class="card-body p-4">
                            <h3 class="card-title mb-3 text-vert-sapin">{{ oeuvre.titre }}</h3>
                            
                            <p class="text-vert-canard fw-bold mb-3">
                                <i class="bi bi-person"></i>
                                {{ oeuvre.artiste.prenom }} {{ oeuvre.artiste.nom }}
                            </p>
                            
                            <div class="mb-3 text-vert-sapin">
                                {% if oeuvre.technique %}
                                    <p class="mb-1"><strong>Technique :</strong> {{ oeuvre.technique }}</p>
                                {% endif %}
                                
                                {% if oeuvre.anneeCreation %}
                                    <p class="mb-1"><strong>Année :</strong> {{ oeuvre.anneeCreation }}</p>
                                {% endif %}
                                
                                {% if oeuvre.hauteurCm and oeuvre.largeurCm %}
                                    <p class="mb-1 text-vert-sapin">
                                        <strong>Dimensions :</strong> 
                                        {{ oeuvre.hauteurCm }} × {{ oeuvre.largeurCm }} 
                                        {% if oeuvre.profondeurCm %}× {{ oeuvre.profondeurCm }}{% endif %} cm
                                    </p>
                                {% endif %}
                            </div>
                            
                            {% if oeuvre.description %}
                                <p class="card-text text-vert-sapin">{{ oeuvre.description }}</p>
                            {% endif %}
                            
                            <a href="{{ path('oeuvre_show', {id: oeuvre.id}) }}" class="btn btn-primary-custom mt-3">
                                <i class="bi bi-eye"></i> Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                Aucune œuvre dans cette exposition pour le moment.
            </div>
        {% endfor %}
    </div>
    
</div>
{% endblock %}
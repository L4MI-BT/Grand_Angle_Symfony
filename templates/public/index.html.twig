{% extends "public/base_public.html.twig" %}

{% block main %}

<div class="container">
    <h2 class="mt-5">{{exposition.titre}}</h2>
    <div class="card mb-3 border-vert-sapin">
        <img src="{{ asset("styles/#{exposition.image}") }}" alt="{{ exposition.titre }}">
        <div class="card-body">
            <h5 class="card-title text-vert-sapin">{{exposition.theme}}</h5>
            <p class="card-text text-vert-sapin">{{exposition.description}}</p>
            <a href="{{ path('exposition_current') }}" class="btn btn-secondary-custom">voir plus</a>
        </div>
    </div>
</div>

<div class="container">
    <h2 class="text-center m-5">LES EXPOS A VENIR</h2>
    {% for item in futurExpo %}
        <h3 class="mt-2">{{item.titre}}</h3>
        <div class="card mb-3 border-vert-sapin">
        <img src="{{ asset("styles/#{item.image}") }}" alt="{{ item.titre }}">
        <div class="card-body">
            <h5 class="card-title text-vert-sapin">{{item.theme}}</h5>
            <p class="card-text text-vert-sapin">{{item.description}}</p>
            <p class="text-muted mb-2">
                <i class="bi bi-calendar-event"></i>
                Du {{ item.dateDebut|date('d/m/Y') }} 
                au {{ item.dateFin|date('d/m/Y') }}
            </p>
            <p class="text-muted mb-4">
                <i class="bi bi-clock"></i>
                <strong>Horaires :</strong> {{ item.horaires }}
            </p>
        </div>
    </div>
        
    {% endfor %}

</div>

{% endblock %}
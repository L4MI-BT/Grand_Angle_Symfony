{% extends 'public/base_public.html.twig' %}

{% block title %}{{artiste.nom}}{{artiste.prenom}}{% endblock %}

{% block main %}
<div class="container">
    <div class="row mt-5">
        <div class="col-md-6">
            <h2>{{artiste.nom}} {{artiste.prenom}}</h2>
            <p>{{artiste.anneeNaissance}}</p>
            <p>{{artiste.description}}</p>
        </div>
        <div class="col-md-6">
            <img src="{{ asset("styles/#{artiste.image}") }}" alt="{{artiste.nom}} {{artiste.prenom}}" class="rounded shadow artiste-img">
        </div>
    </div>
    <div>
        <h3>Oeuvres : </h3>
        <div class="row">
        {% for item in artiste.oeuvres %}
            <div class="col-md-4">
                <div class="card mb-5">
                    <a href="{{ path('oeuvre_show', {id: item.id}) }}">
                        <img src="{{ asset("styles/#{item.image}") }}" alt="{{item.titre}}" class="card-img rounded shadow">
                    </a>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>

</div>
{% endblock %}

{% extends 'admin/base_admin.html.twig' %}

{% block title %}Contenu enrichi - Admin Grand Angle{% endblock %}

{% block main %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Contenu enrichi</h1>
    </div>

    {% for item in contenus %}
    <pre>
        {{ dump(item) }}
    </pre>
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-secondary small mb-1">Oeuvre associée</p>
                    <p class="text-white">{{ item.oeuvre ? item.oeuvre.titre : '-' }}</p>

                    <p class="text-secondary small mb-1">Ordre d'affichage</p>
                    <p class="text-white">{{ item.ordreAffichage ?? '-' }}</p>

                    <p class="text-secondary small mb-1">Ajouté le</p>
                    <p class="text-white">{{ item.dateAjout ? item.dateAjout|date('d/m/Y à H:i') : '-' }}</p>
                </div>
                <div class="col-md-3">
                    <p class="text-secondary small mb-1">URL d'accès</p>
                    {% if item.urlAcces %}
                        <a href="{{ item.urlAcces }}" target="_blank" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-play-circle"></i> Voir le contenu
                        </a>
                    {% else %}
                        <p class="text-secondary fst-italic">Aucune URL</p>
                    {% endif %}
                </div>
                <div class="col-md-3">
                    <a href="{{ path('app_admin_contenu_enrichi_traductions', {'id': item.id}) }}" class="btn btn-outline-info">
                        <i class="bi bi-translate"></i> Traductions
                    </a>
                </div>
            </div>

            {% if item.description %}
                <p class="text-secondary small mb-1 mt-3">Description</p>
                <p class="text-white">{{ item.description }}</p>
            {% endif %}
        </div>
    </div>
    {% endfor %}

    <a href="{{ path('app_admin_contenu_enrichi_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>

{% endblock %}
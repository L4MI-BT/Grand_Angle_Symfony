{% extends 'admin/base_admin.html.twig' %}

{% block title %}Contenus enrichis - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Contenus enrichis</h1>
        <input type="text" class="form-control bg-dark text-white border-secondary w-25" 
            placeholder="Recherche..." id="searchInput">
    </div>

    {# TABLEAU #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <table class="table table-dark table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Oeuvre associée</th>
                        <th>Description</th>
                        <th>URL d'accès</th>
                        <th>Ordre d'affichage</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="contenuList">
                {% for contenu_enrichi in contenu_enrichis %}
                    <tr class="contenu-row">
                        <td>{{ contenu_enrichi.oeuvre ? contenu_enrichi.oeuvre.titre : '-' }}</td>
                        <td>{{ contenu_enrichi.description ?? '-' }}</td>
                        <td>{{ contenu_enrichi.urlAcces ?? '-' }}</td>
                        <td>{{ contenu_enrichi.ordreAffichage ?? '-' }}</td>
                        <td>
                            <a href="{{ path('app_admin_contenu_enrichi_show', {'id': contenu_enrichi.id}) }}" 
                            class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_admin_contenu_enrichi_edit', {'id': contenu_enrichi.id}) }}" 
                            class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-secondary">Aucun contenu enrichi trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# BOUTON AJOUTER #}
    <div class="d-flex justify-content-end">
        <a href="{{ path('app_admin_contenu_enrichi_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un contenu enrichi
        </a>
    </div>

</div>

{# SCRIPT RECHERCHE #}
<script>
document.getElementById('searchInput').addEventListener('input', function() {
    const search = this.value.toLowerCase();
    document.querySelectorAll('.contenu-row').forEach(function(row) {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(search) ? '' : 'none';
    });
});
</script>

{% endblock %}
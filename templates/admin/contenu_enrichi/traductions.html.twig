{% extends 'admin/base_admin.html.twig' %}

{% block title %}Contenu enrichi - {{ oeuvre.titre }}{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Contenu enrichi - {{ oeuvre.titre }}</h1>
        <a href="{{ path('app_admin_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à l'oeuvre
        </a>
    </div>

    {# CONTENUS ENRICHIS #}
    {% if contenus is empty %}
        <div class="alert alert-warning">
            Aucun contenu enrichi pour cette oeuvre.
            <a href="{{ path('app_admin_contenu_enrichi_new') }}" class="btn btn-success btn-sm ms-3">
                <i class="bi bi-plus-circle"></i> Ajouter un contenu
            </a>
        </div>
    {% else %}
        {% for contenu in contenus %}
        <div class="card bg-dark border-secondary mb-4">
            <div class="card-header text-white">
                <strong>{{ contenu.description ?? 'Contenu #' ~ contenu.id }}</strong>
                {% if contenu.urlAcces %}
                    <span class="text-secondary ms-3 small">{{ contenu.urlAcces }}</span>
                {% endif %}
            </div>
            <div class="card-body">
                <h6 class="text-secondary mb-3">Traductions disponibles :</h6>
                <div class="row">
                    {% for langue in langues %}
                        {% if langue.code != 'FR' %}
                            {% set traduction = null %}
                            {% for trad in contenu.traductions %}
                                {% if trad.langue.id == langue.id %}
                                    {% set traduction = trad %}
                                {% endif %}
                            {% endfor %}
                            <div class="col-md-4 mb-3">
                                <div class="card bg-dark border-secondary">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-2">
                                            <img src="{{ asset("styles/#{langue.img}") }}" 
                                                width="24" class="me-2" 
                                                alt="{{ langue.nom }}">
                                            <span class="text-white">{{ langue.nom }}</span>
                                        </div>
                                        {% if traduction %}
                                            <p class="text-secondary small mb-1">{{ traduction.traductionTexte ?? 'Pas de texte' }}</p>
                                            <a href="{{ path('app_admin_contenu_enrichi_traduction_edit', {'oeuvreId': oeuvre.id, 'id': contenu.id, 'tradId': traduction.id}) }}" 
                                            class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i> Modifier
                                            </a>
                                        {% else %}
                                            <p class="text-secondary fst-italic small">Pas encore traduit</p>
                                            <a href="{{ path('app_admin_contenu_enrichi_traduction_new', {'oeuvreId': oeuvre.id, 'id': contenu.id, 'langueCode': langue.code}) }}" 
                                            class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-plus-circle"></i> Ajouter
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endfor %}
    {% endif %}

</div>
{% endblock %}
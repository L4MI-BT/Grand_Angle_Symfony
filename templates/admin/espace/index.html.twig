{% extends 'admin/base_admin.html.twig' %}

{% block title %}Espaces - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Espaces</h1>
    </div>

    {# TABLEAU #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <table class="table table-dark table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Superficie (m²)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for espace in espaces %}
                    <tr>
                        <td>{{ espace.nomEspace }}</td>
                        <td>{{ espace.description ?? '-' }}</td>
                        <td>{{ espace.superficieM2 ?? '-' }}</td>
                        <td>
                            <a href="{{ path('app_admin_espace_show', {'id': espace.id}) }}" 
                            class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_admin_espace_edit', {'id': espace.id}) }}" 
                            class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-secondary">Aucun espace trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# BOUTON AJOUTER #}
    <div class="d-flex justify-content-end">
        <a href="{{ path('app_admin_espace_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un espace
        </a>
    </div>

</div>
{% endblock %}
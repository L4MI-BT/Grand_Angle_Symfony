<form method="post" action="{{ path('app_admin_emplacement_delete', {'id': emplacement.id}) }}" 
    onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet emplacement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emplacement.id) }}">
    <button class="btn btn-outline-danger">
        <i class="bi bi-trash"></i> Supprimer l'emplacement
    </button>
</form>
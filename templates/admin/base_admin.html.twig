<!DOCTYPE html>
<html data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Admin - Grand Angle{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="{{ asset('styles/bootsrap/bootstrap.css') }}">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="admin" style="background-color: #2d3748; color: #e8e8e8;">

        {# SIDEBAR #}
        <div class="d-flex" style="min-height: 100vh;">
            <nav class="d-flex flex-column p-3 bg-dark border-end border-secondary" style="width: 220px;">
                <h5 class="text-white mb-4">
                    <i class="bi bi-grid"></i> Admin
                </h5>
                <ul class="nav nav-pills flex-column gap-1">
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a href="{{ path('app_admin_employe_index') }}" class="nav-link text-white">
                            <i class="bi bi-people-fill"></i> Collaborateur
                        </a>
                    </li>
                    {% endif %}
                    <li class="nav-item">
                        <a href="{{ path('app_admin_exposition_index') }}" class="nav-link text-white">
                            <i class="bi bi-calendar-event"></i> Expositions
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_oeuvre_index') }}" class="nav-link text-white">
                            <i class="bi bi-image"></i> Oeuvres
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_artiste_index') }}" class="nav-link text-white">
                            <i class="bi bi-person"></i> Artistes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_contenu_enrichi_index') }}" class="nav-link text-white">
                            <i class="bi bi-collection-play"></i> Contenus enrichis
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_espace_index') }}" class="nav-link text-white">
                            <i class="bi bi-building"></i> Espaces
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_emplacement_index') }}" class="nav-link text-white">
                            <i class="bi bi-geo-alt"></i> Emplacements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_etape_index') }}" class="nav-link text-white">
                            <i class="bi bi-list-check"></i> Étapes
                        </a>
                    </li>
                </ul>
            </nav>

            {# CONTENU PRINCIPAL #}
            <div class="flex-grow-1 p-4">
                {% if app.user %}
                    <div class="d-flex justify-content-end">
                        Bonjour, <a href="{{ path('app_admin_profil') }}">{{ app.user.prenom }} {{ app.user.nom }}</a>
                    </div>
                {% endif %}
                {% block main %}{% endblock %}
            </div>
        </div>
    </body>
</html>
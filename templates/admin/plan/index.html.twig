{% extends 'admin/base_admin.html.twig' %}

{% block title %}Plan de l'exposition - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">
            Plan de l'exposition
            {% if exposition %}
                - {{ exposition.titre }}
            {% endif %}
        </h1>
        <a href="{{ path('app_admin_oeuvre_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    {% if not exposition %}
        <div class="alert alert-warning">
            Aucune exposition en cours actuellement.
        </div>
    {% else %}

    {# LEGENDE #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <h5 class="text-white mb-3">Légende</h5>
            <div class="row">
                {% for emplacement in emplacements %}
                    {% if emplacement.oeuvres is not empty %}
                        {% for oeuvre in emplacement.oeuvres %}
                        <div class="col-md-3 mb-2">
                            <span class="badge bg-info text-dark me-2">{{ oeuvre.numeroIdentification ?? '?' }}</span>
                            <span class="text-white">{{ oeuvre.titre }}</span>
                        </div>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    {# PLAN SVG #}
    <div class="card bg-dark border-secondary">
        <div class="card-body">
            <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" style="width: 100%; background-color: #1a1a2e; border-radius: 8px;">

                {# BATIMENT PRINCIPAL #}
                <rect x="20" y="20" width="860" height="460" fill="none" stroke="#6c757d" stroke-width="3"/>

                {# HALL PRINCIPAL #}
                <rect x="620" y="20" width="260" height="460" fill="#2a2a3e" stroke="#6c757d" stroke-width="2"/>
                <text x="750" y="260" fill="#adb5bd" font-size="14" text-anchor="middle">Hall Principal</text>

                {# ESPACE 2 (nord-est) #}
                <rect x="320" y="20" width="300" height="220" fill="#2a2a3e" stroke="#6c757d" stroke-width="2"/>
                <text x="470" y="120" fill="#adb5bd" font-size="14" text-anchor="middle">Espace 2</text>

                {# ESPACE 1 (sud-est) #}
                <rect x="320" y="260" width="300" height="220" fill="#2a2a3e" stroke="#6c757d" stroke-width="2"/>
                <text x="470" y="380" fill="#adb5bd" font-size="14" text-anchor="middle">Espace 1</text>

                {# ESPACE 3 (ouest) #}
                <rect x="20" y="20" width="300" height="460" fill="#2a2a3e" stroke="#6c757d" stroke-width="2"/>
                <text x="170" y="260" fill="#adb5bd" font-size="14" text-anchor="middle">Espace 3</text>

                {# EMPLACEMENTS ET OEUVRES #}
                {% for emplacement in emplacements %}
                    {% if emplacement.oeuvres is not empty %}
                        {% for oeuvre in emplacement.oeuvres %}
                            {# On convertit les coordonnées X/Y en pixels #}
                            {% set px = (emplacement.positionX * 100) %}
                            {% set py = (emplacement.positionY * 100) %}

                            <a href="{{ path('app_admin_oeuvre_edit', {'id': oeuvre.id}) }}">
                                <rect x="{{ px - 15 }}" y="{{ py - 15 }}" 
                                    width="30" height="30" 
                                    fill="#0dcaf0" stroke="#fff" stroke-width="1" 
                                    rx="4"/>
                                <text x="{{ px }}" y="{{ py + 5 }}" 
                                    fill="#000" font-size="12" 
                                    text-anchor="middle" font-weight="bold">
                                    {{ oeuvre.numeroIdentification ?? '?' }}
                                </text>
                            </a>
                        {% endfor %}
                    {% endif %}
                {% endfor %}

            </svg>
        </div>
    </div>

    {% endif %}

</div>
{% endblock %}
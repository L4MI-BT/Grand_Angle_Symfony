{% extends 'base.html.twig' %}

{% block title %}Artiste{% endblock %}

{% block body %}
    <h1>Artiste</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ artiste.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ artiste.prenom }}</td>
            </tr>
            <tr>
                <th>AnneeNaissance</th>
                <td>{{ artiste.anneeNaissance }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ artiste.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ artiste.image }}</td>
            </tr>
            <tr>
                <th>DateAjout</th>
                <td>{{ artiste.dateAjout ? artiste.dateAjout|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_artiste_index') }}">back to list</a>

    <a href="{{ path('app_admin_artiste_edit', {'id': artiste.id}) }}">edit</a>

    {{ include('admin/artiste/_delete_form.html.twig') }}
{% endblock %}

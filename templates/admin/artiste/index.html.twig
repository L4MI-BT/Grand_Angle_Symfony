{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tous les artistes - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Tous les artistes</h1>
        <input type="text" class="form-control bg-dark text-white border-secondary w-25" 
            placeholder="Recherche..." id="searchInput">
    </div>

    {# TABLEAU #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <table class="table table-dark table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Année de naissance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="artistesList">
                {% for artiste in artistes %}
                    <tr class="artiste-row">
                        <td>{{ artiste.nom }}</td>
                        <td>{{ artiste.prenom }}</td>
                        <td>{{ artiste.anneeNaissance ?? '-' }}</td>
                        <td>
                            <a href="{{ path('app_admin_artiste_edit', {'id': artiste.id}) }}" 
                            class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('app_admin_artiste_show', {'id': artiste.id}) }}" 
                            class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-secondary">Aucun artiste trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# BOUTONS BAS #}
    <div class="d-flex justify-content-between">
        <a href="{{ path('app_admin_artiste_associer') }}" class="btn btn-outline-secondary">
            <i class="bi bi-link"></i> Associer Oeuvres / Artiste
        </a>
        <a href="{{ path('app_admin_artiste_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un artiste
        </a>
    </div>

</div>

{# SCRIPT RECHERCHE #}
<script>
document.getElementById('searchInput').addEventListener('input', function() {
    const search = this.value.toLowerCase();
    document.querySelectorAll('.artiste-row').forEach(function(row) {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(search) ? '' : 'none';
    });
});
</script>

{% endblock %}
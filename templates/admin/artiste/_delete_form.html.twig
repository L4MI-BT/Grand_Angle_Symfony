{% if artiste.oeuvres is empty %}
    <form method="post" action="{{ path('app_admin_artiste_delete', {'id': artiste.id}) }}" 
        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet artiste ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artiste.id) }}">
        <button class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Supprimer l'artiste
        </button>
    </form>
{% else %}
    <button class="btn btn-outline-danger" disabled title="Impossible de supprimer : cet artiste a des œuvres associées">
        <i class="bi bi-trash"></i> Supprimer l'artiste
    </button>
    <small class="text-secondary ms-2">Suppression impossible : {{ artiste.oeuvres|length }} œuvre(s) associée(s)</small>
{% endif %}
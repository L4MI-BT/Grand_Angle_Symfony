<!DOCTYPE html>

<title>Etape</title>

{% block body %}
    <h1>Etape</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ etape.id }}</td>
            </tr>
            <tr>
                <th>Libelle</th>
                <td>{{ etape.libelle }}</td>
            </tr>
            <tr>
                <th>Ordre</th>
                <td>{{ etape.ordre }}</td>
            </tr>
            <tr>
                <th>EstComplete</th>
                <td>{{ etape.estComplete ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_etape_index') }}">back to list</a>

    <a href="{{ path('app_admin_etape_edit', {'id': etape.id}) }}">edit</a>

    {{ include('admin/etape/_delete_form.html.twig') }}
{% endblock %}

{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ etape.libelle }} - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">{{ etape.libelle }}</h1>
        <a href="{{ path('app_admin_etape_edit', {'id': etape.id}) }}" 
        class="btn btn-outline-warning">
            <i class="bi bi-pencil"></i> Modifier
        </a>
    </div>

    {# INFOS #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-secondary small mb-1">Ordre</p>
                    <p class="text-white">{{ etape.ordre }}</p>

                    <p class="text-secondary small mb-1">Exposition</p>
                    <p class="text-white">{{ etape.exposition ? etape.exposition.titre : '-' }}</p>
                </div>
                <div class="col-md-6">
                    <p class="text-secondary small mb-1">Complète</p>
                    <p>
                        {% if etape.estComplete %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-secondary">Non</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# BOUTON RETOUR #}
    <a href="{{ path('app_admin_etape_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>

</div>
{% endblock %}
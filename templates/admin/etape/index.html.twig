{% extends 'admin/base_admin.html.twig' %}

{% block title %}Étapes - Admin Grand Angle{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Étapes</h1>
    </div>

    {# TABLEAU #}
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
            <table class="table table-dark table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Libellé</th>
                        <th>Ordre</th>
                        <th>Exposition</th>
                        <th>Complète</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for etape in etapes %}
                    <tr>
                        <td>{{ etape.libelle }}</td>
                        <td>{{ etape.ordre }}</td>
                        <td>{{ etape.exposition ? etape.exposition.titre : '-' }}</td>
                        <td>
                            {% if etape.estComplete %}
                                <span class="badge bg-success">Oui</span>
                            {% else %}
                                <span class="badge bg-secondary">Non</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_admin_etape_show', {'id': etape.id}) }}" 
                            class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_admin_etape_edit', {'id': etape.id}) }}" 
                            class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-secondary">Aucune étape trouvée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# BOUTON AJOUTER #}
    <div class="d-flex justify-content-end">
        <a href="{{ path('app_admin_etape_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter une étape
        </a>
    </div>

</div>
{% endblock %}
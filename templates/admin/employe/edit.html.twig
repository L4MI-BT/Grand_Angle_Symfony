{% extends "admin/base_admin.html.twig" %}

{% block title %}Employe{% endblock %}

{% block main %}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white">Modifier un collaborateur</h1>
    </div>

    <div class="card bg-dark border-secondary">
        <div class="card-body">
            {{ include('admin/employe/_form.html.twig') }}

            {% if employe.role !== 'admin' %}
                <div class="m-3">{{ include('admin/employe/_delete_form.html.twig') }}</div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}

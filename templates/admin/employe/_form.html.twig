{{ form_start(form, {'attr': {'class': 'p-3'}}) }}

    <div class="mb-3">
        {{ form_label(form.nom, 'NOM', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.nom,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.prenom, 'PRENOM', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.prenom,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.fonction, 'FONCTION', {'label_attr': {'class': 'form-label text-white'}})}}
        <div class="row g-3">
            <div class="col-8">
                {{ form_widget(form.fonction,{'attr': {'class': 'form-select bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-4 text-center">
                <a href="{{ path('app_admin_fonction_new')}}" class="btn btn-sm btn-outline-warning mb-1">
                    <i class="bi bi-pencil"></i> Ajouter une fonction
                </a>
            </div>
        </div>
    </div>

    <div class="mb-3">
        {{ form_label(form.email, 'EMAIL', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.email,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.login, 'LOGIN', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.login,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(form.mdp, 'MOT DE PASSE', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.mdp,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.role, 'ROLE', {'label_attr': {'class': 'form-label text-white'}})}}
        {{ form_widget(form.role,{'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
        </div>
    </div>

    <div class="m-3">
        <div class="d-flex justify-content-between">
            <a href="{{ path('app_admin_employe_index') }}" class="btn btn-outline-danger">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> {{ button_label|default('Valider') }}
            </button>
        </div>
    </div>

{{form_end(form)}}
